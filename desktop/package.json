{
  "name": "soc-platform-desktop",
  "productName": "SOC Platform",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop shell for the AI-Powered Network Threat Detection platform. Launches the local Python security engine and serves the React SOC dashboard in a single app.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:frontend": "npm.cmd --prefix ../ids-platform/frontend run build",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\ids-platform\\scripts\\build_engine.ps1",
    "dist": "electron-builder --win --config electron-builder.yml",
    "pack:dir": "electron-builder --win --config electron-builder.yml --dir"
  },
  "author": "SOC Platform Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  }
}