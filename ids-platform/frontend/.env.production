# Production (packaged desktop) build: the Electron shell serves the built
# frontend from the same origin as the local back-end engine (127.0.0.1:8000),
# so API and WebSocket URLs point at that single origin. Dev builds ignore
# this file and use the defaults in src/services/* (localhost:8000).
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/alerts