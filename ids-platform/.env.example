# Copy this file to `.env` and adjust as needed.
# backend/core/config.py reads these; every variable has a built-in default,
# so a missing .env file is fine for local development.

# Directory containing versioned model artifacts (models/v1/, models/v2/, ...)
MODEL_PATH=models

# Reported by GET / and GET /health, and used as the OpenAPI version.
API_VERSION=1.0.0

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

# Comma-separated allowed origins, or "*" for any origin (default - fine for
# local dev, tighten this in production).
CORS_ORIGINS=*

# Placeholder - real rate limiting is a future milestone.
ENABLE_RATE_LIMIT=false
