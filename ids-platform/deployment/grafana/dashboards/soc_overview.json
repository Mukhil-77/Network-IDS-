{
  "title": "SOC Overview",
  "uid": "soc-overview",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"backend\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Threat rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(alert_total[1m])", "legendFormat": "alerts/s", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "graph",
      "title": "Prediction latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(prediction_latency_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "A" }
      ]
    }
  ]
}
